{
  "name": "train-app",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run coverage",
    "web:build": "vite build",
    "e2e": "playwright test",
    "build": "pnpm run verify && pnpm run web:build && pnpm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@10.17.0",
  "dependencies": {
    "vue": "^3.5.38"
  }
}
